# Node & Server Environment
NODE_ENV="development"
PORT="3000"
CORS_ORIGIN="*"

# Database Configuration (PostgreSQL)
# Primary preferred connection URL:
DATABASE_URL="postgresql://postgres:password@localhost:5432/legomark_db"

# Alternative discrete PostgreSQL parameters:
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="password"
DB_NAME="legomark_db"
DB_SSL="false"

# Application runtime URLs & Keys
APP_URL="http://localhost:3000"
GEMINI_API_KEY=""

# Media & Uploads Storage (Coolify Persistent Volume / Mount)
# Production recommendation for Coolify volume mount: /app/data/uploads
# Default (if unset): ./public/uploads
UPLOADS_DIR="/app/data/uploads"

# Admin Authentication & Sessions
SESSION_SECRET="your_secure_random_session_secret_min_32_characters"
ADMIN_COOKIE_SECURE="false" # set to "true" in production with HTTPS/Coolify
ADMIN_SESSION_MAX_AGE_DAYS="7"

# Optional Initial Admin Bootstrap (Used only when explicitly running npm run auth:bootstrap)
ADMIN_INITIAL_EMAIL="admin@legomarkindia.com"
ADMIN_INITIAL_NAME="LEGOMARK INDIA Administrator"

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

